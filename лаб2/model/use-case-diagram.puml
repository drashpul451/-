@startuml
top to bottom direction
title E-Library System — Use Case Diagram (Lab 2)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseFontSize 12
skinparam nodesep 30
skinparam ranksep 40

' ---------- Актори ----------
actor "Guest" as Guest
actor "User" as User
actor "Librarian" as Librarian

' Успадкування
User <|-- Librarian

' ---------- Система ----------
rectangle "E-Library System" {
  usecase "UC-01: Пошук та перегляд каталогу" as UC01
  usecase "UC-02: Авторизація (Log In)" as UC02
  usecase "UC-03: Перегляд історії Loan" as UC03
  usecase "UC-04: Створення запиту на Loan" as UC04
  usecase "UC-05: Додавання Book та Author" as UC05
  usecase "UC-06: Підтвердження повернення книги" as UC06
  usecase "UC-07: Надсилання сповіщень про борги" as UC07
}

' ---------- Зовнішня система ----------
rectangle "Notification Service\n<<System>>" as NotifSvc {
}

' ---------- Зв'язки ----------
Guest --> UC01
Guest --> UC02

User --> UC03
User --> UC04

Librarian --> UC05
Librarian --> UC06

UC07 ..> NotifSvc : <<delegate>>

' ---------- Примітки ----------
note right of UC02
  **Precondition:**
  UC-02 є передумовою
  для авторизованих дій
  і не використовує <<include>>.
end note

note bottom of NotifSvc
  Зовнішній сервіс (<<System>>),
  що надсилає листи про
  прострочений due_date.
end note

@enduml
